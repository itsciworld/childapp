# API configuration
API_BASE_URL=http://160-153-179-249.sslip.io
# The backend runs on Render's free tier: it spins down after ~15 min idle and
# can take up to ~60s to cold-start. RECEIVE_TIMEOUT must be >= 60s or the first
# (waking) request — e.g. OTP verify / pairing — is aborted mid-cold-start.
CONNECT_TIMEOUT=35000
RECEIVE_TIMEOUT=60000
